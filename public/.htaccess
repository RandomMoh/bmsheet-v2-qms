# Temporarily Shut Down QMS Portal — Dev Terminal Remains Accessible
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /qms_react/

  # Allow shutdown page itself
  RewriteRule ^shutdown\.html$ - [L]

  # Allow all API calls (webhooks, dev terminal backend, etc.)
  RewriteCond %{REQUEST_URI} ^/qms_react/api/ [NC]
  RewriteRule ^ - [L]

  # Allow static assets
  RewriteCond %{REQUEST_URI} ^/qms_react/assets/ [NC]
  RewriteRule ^ - [L]

  # Allow index.html directly
  RewriteRule ^index\.html$ - [L]

  # Allow root request (serves index.html, React Router handles the rest)
  RewriteRule ^$ /qms_react/index.html [L]

  # Allow /dev route
  RewriteRule ^dev$ /qms_react/index.html [L]

  # Redirect everything else to shutdown page
  RewriteCond %{REQUEST_URI} !^/qms_react/shutdown\.html$
  RewriteCond %{REQUEST_URI} !^/qms_react/api/ [NC]
  RewriteCond %{REQUEST_URI} !^/qms_react/assets/ [NC]
  RewriteCond %{REQUEST_URI} !^/qms_react/index\.html$
  RewriteCond %{REQUEST_URI} !^/qms_react/dev$
  RewriteRule ^(.*)$ /qms_react/shutdown.html [R=302,L]
</IfModule>
