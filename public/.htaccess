# Gzip / DEFLATE compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser caching — hashed assets get 1 year, everything else stays fresh
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML must never be cached — it references hashed JS/CSS filenames
  ExpiresByType text/html "access plus 0 seconds"
  # Hashed assets can be cached forever (filename changes on rebuild)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  # API JSON responses must NEVER be cached
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Prevent caching of index.html specifically
<Files "index.html">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</Files>

# Force Apache to serve index.html instead of any index.php
DirectoryIndex index.html

# SPA fallback — serve index.html for React Router
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /qms_react/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/qms_react/api/ [NC]
  RewriteRule . /qms_react/index.html [L]
</IfModule>
